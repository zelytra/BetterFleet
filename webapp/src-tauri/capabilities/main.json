{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Main BetterFleet window: backend HTTP, logging, the event bus, and control of the overlay window's visibility/focus.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*/*" },
        { "url": "http://127.0.0.1:*/*" },
        { "url": "https://**" }
      ]
    },
    "log:default",
    "shell:allow-open",
    "oauth:allow-start",
    "oauth:allow-cancel",
    "clipboard-manager:allow-write-text",
    "updater:default",
    "process:allow-restart"
  ]
}
